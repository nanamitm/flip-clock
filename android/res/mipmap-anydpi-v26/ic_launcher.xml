<?xml version="1.0" encoding="utf-8"?>
<!--
    Adaptive launcher icon (API 26+). The launcher masks the two layers into
    whatever shape the device theme uses, and parallaxes them against each
    other, which is why the card is drawn well inside the safe zone.

    The monochrome layer is used by themed icons on API 33+ and ignored by
    older releases.
-->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@mipmap/ic_launcher_background" />
    <foreground android:drawable="@mipmap/ic_launcher_foreground" />
    <monochrome android:drawable="@mipmap/ic_launcher_monochrome" />
</adaptive-icon>
