{
  "version": 3,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 21,
    "patch": 1
  },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}"
    },
    {
      "name": "windows-base",
      "hidden": true,
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_PREFIX_PATH": "$env{QT_DIR_DESKTOP}"
      },
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      }
    },
    {
      "name": "windows-msvc-debug",
      "displayName": "Windows (MSVC x64) Debug",
      "inherits": "windows-base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "windows-msvc-release",
      "displayName": "Windows (MSVC x64) Release",
      "inherits": "windows-base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo"
      }
    },
    {
      "name": "android-base",
      "hidden": true,
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "QT_HOST_PATH": "$env{QT_DIR_DESKTOP}",
        "ANDROID_SDK_ROOT": "$env{ANDROID_SDK_ROOT}",
        "ANDROID_NDK_ROOT": "$env{ANDROID_NDK_ROOT}",
        "ANDROID_PLATFORM": "android-28",
        "ANDROID_STL": "c++_shared"
      }
    },
    {
      "name": "android-arm64",
      "displayName": "Android arm64-v8a (device)",
      "inherits": "android-base",
      "toolchainFile": "$env{QT_DIR_ANDROID_ARM64}/lib/cmake/Qt6/qt.toolchain.cmake",
      "cacheVariables": {
        "ANDROID_ABI": "arm64-v8a"
      }
    },
    {
      "name": "android-x86_64",
      "displayName": "Android x86_64 (emulator)",
      "inherits": "android-base",
      "toolchainFile": "$env{QT_DIR_ANDROID_X86_64}/lib/cmake/Qt6/qt.toolchain.cmake",
      "cacheVariables": {
        "ANDROID_ABI": "x86_64"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "windows-msvc-debug",
      "configurePreset": "windows-msvc-debug"
    },
    {
      "name": "windows-msvc-release",
      "configurePreset": "windows-msvc-release"
    },
    {
      "name": "android-arm64",
      "configurePreset": "android-arm64"
    },
    {
      "name": "android-arm64-apk",
      "configurePreset": "android-arm64",
      "targets": [
        "apk"
      ]
    },
    {
      "name": "android-x86_64",
      "configurePreset": "android-x86_64"
    },
    {
      "name": "android-x86_64-apk",
      "configurePreset": "android-x86_64",
      "targets": [
        "apk"
      ]
    }
  ]
}
